@page "/scan/{qrGuid:guid}"
@model iskolaraktarFrontend.Pages.ScanModel

@{
    ViewData["Title"] = "QR leolvasás";
}

<div class="text-center mt-5">

    <h1 class="mb-3">
        Leltári eszköz beolvasása
    </h1>

    <p class="text-muted">
        QR-azonosító:
    </p>

    <p class="fs-5">
        <strong>@Model.QrGuid</strong>
    </p>

    <div id="scanResult"
         class="alert alert-info mt-4">
        Eszköz keresése...
    </div>

</div>

@section Scripts {
    <script type="module"
            src="~/js/controllers/scan-controller.js"
            asp-append-version="true">
    </script>
}