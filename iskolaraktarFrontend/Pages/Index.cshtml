@page
@model IndexModel

@{
    ViewData["Title"] = "Kezdőlap";
}

@section Styles {
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
}

<div class="home-header">
    <h1 class="home-title">Iskolai Raktár</h1>
    <p class="home-subtitle">
        Iskolai leltár- és raktárkezelő rendszer
    </p>
</div>

<div class="row g-4">

    <div class="col-md-6">
        <a asp-page="/Leltar"
           class="text-decoration-none text-reset">

            <div class="card feature-card">
                <div class="card-body">

                    <h2 class="feature-card-title">
                        Leltárkörzetek
                    </h2>

                    <p class="feature-card-text">
                        Leltárkörzetek megtekintése és a hozzájuk tartozó eszközök kezelése.
                    </p>

                </div>
            </div>

        </a>
    </div>

    <div class="col-md-6">
        <a asp-page="/Admin"
           class="text-decoration-none text-reset">

            <div class="card feature-card">
                <div class="card-body">

                    <h2 class="feature-card-title">
                        Felhasználó / Leltárkörzet módosítás
                    </h2>

                    <p class="feature-card-text">
                        Felhasználók, jogosultságok és leltárkörzetek adminisztrációja.
                    </p>

                </div>
            </div>

        </a>
    </div>

</div>