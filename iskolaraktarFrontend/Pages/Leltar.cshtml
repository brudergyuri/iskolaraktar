@page
@model iskolaraktarFrontend.Pages.LeltarModel

@{
    ViewData["Title"] = "Leltár";
}

<div class="mb-4">
    <h1>Leltár</h1>
    <p class="text-muted">
        Leltárkörzet kiválasztása és a hozzá tartozó tételek kezelése.
    </p>
</div>

<div id="inventoryError"
     class="alert alert-danger d-none"
     role="alert">
</div>

<div id="inventorySuccess"
     class="alert alert-success d-none"
     role="alert">
</div>

<div class="mb-4">
    <label for="tableSelect" class="form-label">
        Leltárkörzet
    </label>

    <select id="tableSelect"
            class="form-select">
        <option value="">
            Betöltés...
        </option>
    </select>
</div>

<div id="inventoryLoading"
     class="text-muted d-none mb-3">
    Adatok betöltése...
</div>

<div id="itemFormContainer"
     class="card mb-4 d-none">

    <div class="card-body">
        <h2 class="h5 mb-3">
            Új leltári tétel
        </h2>

        <form id="itemForm">

            <div id="itemFormFields"
                 class="row g-3">
            </div>

            <div class="mt-3">
                <button type="submit"
                        class="btn btn-primary"
                        id="createItemButton">
                    Tétel hozzáadása
                </button>
            </div>

        </form>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-striped table-bordered d-none"
           id="inventoryTable">

        <thead id="inventoryTableHead">
        </thead>

        <tbody id="inventoryTableBody">
        </tbody>

    </table>
</div>

@section Scripts {
    <script type="module"
            src="~/js/controllers/inventory-controller.js"
            asp-append-version="true">
    </script>
}